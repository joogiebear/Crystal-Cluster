{
  "name": "crystal-cluster",
  "version": "1.0.0",
  "private": true,
  "description": "Crystal Cluster, a mobile-first idle/tap game. The web build has no build step and no runtime dependencies.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test",
    "build:www": "node tools/build-www.mjs",
    "ios:sync": "npm run build:www && cap sync ios",
    "ios:open": "cap open ios",
    "store:metadata": "node tools/make-store-metadata.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "crystal-native": "file:native/crystal-native"
  }
}
